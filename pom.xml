<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>top.lldwb</groupId>
    <artifactId>AList-Media-Sync</artifactId>
    <version>0.1.0</version>
    <name>AList-Media-Sync</name>
    <description>AList-Media-Sync</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <!-- 前端构建开关：-Dskip.frontend=true 跳过前端构建 -->
        <skip.frontend>false</skip.frontend>
        <!-- JRE 本地路径：-Djre.local.path=/path/to/jre 使用本地 JRE 跳过下载 -->
        <jre.local.path></jre.local.path>
        <!-- 临时工作目录 -->
        <bootstrap.tmp.dir>${project.build.directory}/bootstrap-tmp</bootstrap.tmp.dir>
    </properties>

    <!-- ============================================================
         依赖版本统一管理
         ============================================================ -->
    <dependencyManagement>
        <!-- Spring AI：MCP 服务器集成（research.md R1）版本由 BOM 统一管理 -->
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>2.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Security Crypto：仅用于 BCrypt 密码哈希，不引入完整 Security 框架（YAGNI） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Jackson JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JAVE2：Java 封装的 FFmpeg 转码库 -->
        <dependency>
            <groupId>ws.schild</groupId>
            <artifactId>jave-core</artifactId>
            <version>3.5.0</version>
        </dependency>
        <!-- JAVE2 Windows 64位原生二进制（开发环境） -->
        <dependency>
            <groupId>ws.schild</groupId>
            <artifactId>jave-nativebin-win64</artifactId>
            <version>3.5.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- JAVE2 Linux 64位原生二进制（生产/Docker环境） -->
        <dependency>
            <groupId>ws.schild</groupId>
            <artifactId>jave-nativebin-linux64</artifactId>
            <version>3.5.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- WebSocket 支持：实时推送替代 HTTP 轮询 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- WireMock：AList REST 契约模拟（集成测试，research.md R1） -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.1</version>
            <scope>test</scope>
        </dependency>

        <!-- spring-boot-restclient：TestRestTemplate 自动配置依赖 RestTemplateBuilder（E2E 测试） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SpringDoc OpenAPI：通过代码注解自动生成 API 文档（@Tag/@Operation/@Schema） -->
        <!-- v3.0.3 基于 Spring Boot 4.0.5，官方支持 Spring Boot 4.x，与项目 4.1.0 兼容 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Spring AI MCP Server（Web MVC 变体）：嵌入标准 MCP 服务器，端点 /mcp 同端口提供工具（FR-001/FR-002） -->
        <!-- 版本由 spring-ai-bom 统一管理；注解式 @Tool/@ToolParam 自动扫描注册，复用现有 Service 层（FR-009） -->
        <!-- 依赖链全程 Jackson 3（tools.jackson），与项目 JSON 库一致，无 com.fasterxml.jackson 混入（research.md R2） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                    <!-- 排除集成测试与端到端测试，由 maven-failsafe-plugin 在 -Pintegration/-Pe2e profile 下驱动（FR-005） -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*E2ETest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- maven-failsafe-plugin：集成测试与端到端测试生命周期管理（research.md R2） -->
            <!-- 默认不激活，通过 -Pintegration（*IT.java）或 -Pe2e（*E2ETest.java）profile 触发 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!-- maven-antrun-plugin：校验测试 fixtures 体积（T007） -->
            <!-- validate 阶段校验 src/test/resources/fixtures/ 总体积 < 10MB，超阈构建失败，防止大体积媒体污染版本控制 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>check-fixtures-size</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <length property="fixtures.size" mode="all">
                                    <fileset dir="${project.basedir}/src/test/resources/fixtures" erroronmissingdir="false"/>
                                </length>
                                <echo message="T007 fixtures 总体积 = ${fixtures.size} 字节（上限 10485760）"/>
                                <condition property="fixtures.too.large">
                                    <matches string="${fixtures.size}" pattern="^(1048576[1-9]|104857[7-9][0-9]|10485[89][0-9]{2}|1048[6-9][0-9]{3}|1049[0-9]{4}|10[5-9][0-9]{5}|1[1-9][0-9]{6}|[2-9][0-9]{7}|[0-9]{9,})$"/>
                                </condition>
                                <fail if="fixtures.too.large" message="测试 fixtures 目录总体积 ${fixtures.size} 字节超过 10MB (10485760) 上限（T007，防止大体积媒体污染版本控制）"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ============================================================
         Profiles
         ============================================================ -->

    <profiles>
        <!--
            bootstrap Profile：一体化启动包打包
            激活：./mvnw package -P bootstrap
            参见 specs/005-standalone-bootstrap/contracts/build-packaging.md
        -->
        <profile>
            <id>bootstrap</id>
            <build>
                <plugins>
                    <!-- 前端构建集成：检查 Node.js，执行 npm run build -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <!-- validate 阶段：检查 Node.js 可用性 -->
                            <execution>
                                <id>check-nodejs</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>node</executable>
                                    <arguments>
                                        <argument>--version</argument>
                                    </arguments>
                                    <skip>${skip.frontend}</skip>
                                </configuration>
                            </execution>

                            <!-- compile 阶段：执行 npm run build -->
                            <execution>
                                <id>build-frontend</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <workingDirectory>${project.basedir}/src/main/frontend</workingDirectory>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                    <skip>${skip.frontend}</skip>
                                </configuration>
                            </execution>

                            <!-- package 阶段：下载 JRE -->
                            <execution>
                                <id>download-jre</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/scripts/download-jre.sh</executable>
                                    <arguments>
                                        <argument>${project.build.directory}/runtime</argument>
                                    </arguments>
                                    <skip>${jre.local.path.not.empty}</skip>
                                </configuration>
                            </execution>

                            <!-- verify 阶段：完整性校验 -->
                            <execution>
                                <id>verify-package</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.basedir}/scripts/verify-build.sh</executable>
                                    <arguments>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Maven Assembly Plugin：组装启动包 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <descriptors>
                                <descriptor>assembly/bootstrap.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>make-assembly</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- maven-clean-plugin：清理 bootstrap 临时文件 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${bootstrap.tmp.dir}</directory>
                                    <followSymlinks>false</followSymlinks>
                                </fileset>
                                <fileset>
                                    <directory>${project.build.directory}/runtime</directory>
                                    <followSymlinks>false</followSymlinks>
                                </fileset>
                            </filesets>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            gen-api-doc Profile：API 文档静态导出
            激活：./mvnw verify -Pgen-api-doc
            作用：启动应用 → 抓取 /v3/api-docs.yaml → 输出 target/openapi.{json,yaml}
            常规构建（mvn verify/package）不会触发，避免污染。
            详见 specs/011-docs-system-optimization/contracts/api-doc-generation-contract.md
        -->
        <profile>
            <id>gen-api-doc</id>
            <build>
                <plugins>
                    <!-- 启动 Spring Boot 应用以供 SpringDoc 抓取 OpenAPI -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>start-app</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>stop-app</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- 抓取运行时 /v3/api-docs.yaml 到 target/openapi.{json,yaml} -->
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>1.5</version>
                        <executions>
                            <execution>
                                <id>integration-test</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            integration Profile：集成测试
            激活：./mvnw verify -Pintegration
            驱动：maven-failsafe-plugin 执行 *IT.java（Repository @DataJpaTest + AList WireMock 契约测试）
            作用：验证数据持久化与外部契约交互的真实正确性，无外部二进制依赖（H2 内存 + WireMock 进程内）
            详见 specs/012-e2e-test-infrastructure/contracts/e2e-maven-profile.md
        -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/*IT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            e2e Profile：端到端测试
            激活：./mvnw verify -Pe2e
            驱动：maven-failsafe-plugin 执行 *E2ETest.java（3 条核心链路 + traceId 链路验证）
            串行执行：forkCount=1, reuseForks=false 保证链路间串行（FR-012），避免端口与状态争抢
            超时兜底：forkedProcessExitTimeoutInSeconds=900 防止 fork 进程挂死（SC-006）
            外部依赖：E2ELifecycleManager 自动启动 AList 二进制、动态端口分配（FR-014）
            事件驱动：WebhookEventReplayer 重放 fixtures/webhook/ 样本注入系统（FR-011）
            详见 specs/012-e2e-test-infrastructure/contracts/e2e-maven-profile.md
        -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/*E2ETest.java</include>
                                    </includes>
                                    <forkCount>1</forkCount>
                                    <reuseForks>false</reuseForks>
                                    <forkedProcessExitTimeoutInSeconds>900</forkedProcessExitTimeoutInSeconds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
